<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GoAdapterProjectDirectory>$(MSBuildProjectDirectory)/../adapters/go/worker</GoAdapterProjectDirectory>
    <GoAdapterExecutableName>merkle-adapter-go</GoAdapterExecutableName>
    <GoAdapterIntermediatePath>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/go/$(GoAdapterExecutableName)</GoAdapterIntermediatePath>
    <GoAdapterGoOs Condition="$(RuntimeIdentifier.StartsWith('linux-'))">linux</GoAdapterGoOs>
    <GoAdapterGoOs Condition="$(RuntimeIdentifier.StartsWith('osx-'))">darwin</GoAdapterGoOs>
    <GoAdapterGoArch Condition="$(RuntimeIdentifier.EndsWith('-x64'))">amd64</GoAdapterGoArch>
    <GoAdapterGoArch Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</GoAdapterGoArch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../core/Merkle.Core.csproj" />
    <ProjectReference Include="../infrastructure/Merkle.Infrastructure.csproj" />
    <ProjectReference Include="../adapters/dotnet/Merkle.Adapters.DotNet.csproj" />
    <ProjectReference Include="../adapters/go/host/Merkle.Adapters.Go.csproj" />
    <ProjectReference Include="../adapters/dotnet/worker/Merkle.Adapters.DotNet.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="../adapters/dotnet/observer/Merkle.Adapters.DotNet.Observer.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <GoAdapterSource Include="$(GoAdapterProjectDirectory)/**/*.go" />
    <GoAdapterSource Include="$(GoAdapterProjectDirectory)/go.mod" />
    <GoAdapterSource Include="$(GoAdapterProjectDirectory)/go.sum" Condition="Exists('$(GoAdapterProjectDirectory)/go.sum')" />
  </ItemGroup>

  <Target Name="BuildGoAdapter"
          BeforeTargets="Build;Publish"
          Inputs="@(GoAdapterSource)"
          Outputs="$(GoAdapterIntermediatePath)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GoAdapterIntermediatePath)'))" />
    <Exec WorkingDirectory="$(GoAdapterProjectDirectory)"
          Command="go build -trimpath -o &quot;$(GoAdapterIntermediatePath)&quot; ."
          EnvironmentVariables="CGO_ENABLED=0;GOOS=$(GoAdapterGoOs);GOARCH=$(GoAdapterGoArch)"
          Condition="'$(GoAdapterGoOs)' != '' and '$(GoAdapterGoArch)' != ''" />
    <Exec WorkingDirectory="$(GoAdapterProjectDirectory)"
          Command="go build -trimpath -o &quot;$(GoAdapterIntermediatePath)&quot; ."
          EnvironmentVariables="CGO_ENABLED=0"
          Condition="'$(GoAdapterGoOs)' == '' or '$(GoAdapterGoArch)' == ''" />
  </Target>

  <Target Name="CopyGoAdapterToBuild" AfterTargets="Build" DependsOnTargets="BuildGoAdapter">
    <MakeDir Directories="$(OutDir)workers/go" />
    <Copy SourceFiles="$(GoAdapterIntermediatePath)"
          DestinationFiles="$(OutDir)workers/go/$(GoAdapterExecutableName)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDotNetToolchain" AfterTargets="Publish">
    <ItemGroup>
      <DotNetToolchainArtifact Include="$(MSBuildProjectDirectory)/../adapters/dotnet/worker/bin/$(Configuration)/net10.0/**/*"
                              Exclude="$(MSBuildProjectDirectory)/../adapters/dotnet/worker/bin/$(Configuration)/net10.0/$(RuntimeIdentifier)/**/*" />
      <DotNetToolchainArtifact Include="$(MSBuildProjectDirectory)/../adapters/dotnet/observer/bin/$(Configuration)/net8.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DotNetToolchainArtifact)"
          DestinationFiles="@(DotNetToolchainArtifact->'$(PublishDir)workers/dotnet/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)workers/dotnet/Merkle.Adapters.DotNet.Worker.dll')"
           Text="The published CLI is missing the managed .NET semantic worker." />
    <Error Condition="!Exists('$(PublishDir)workers/dotnet/Merkle.Adapters.DotNet.Observer.dll')"
           Text="The published CLI is missing the .NET startup-hook observer." />
  </Target>

  <Target Name="CopyGoAdapterToPublish" AfterTargets="Publish" DependsOnTargets="BuildGoAdapter">
    <MakeDir Directories="$(PublishDir)workers/go" />
    <Copy SourceFiles="$(GoAdapterIntermediatePath)"
          DestinationFiles="$(PublishDir)workers/go/$(GoAdapterExecutableName)"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)workers/go/$(GoAdapterExecutableName)')"
           Text="The published CLI is missing the Go language-adapter worker." />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <MerkleIncludeDotNetAdapter Condition="'$(MerkleIncludeDotNetAdapter)' == ''">true</MerkleIncludeDotNetAdapter>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../core/Merkle.Core.csproj" />
    <ProjectReference Include="../infrastructure/Merkle.Infrastructure.csproj" />
    <ProjectReference Include="../adapters/dotnet/Merkle.Adapters.DotNet.csproj" />
    <ProjectReference Include="../adapters/go/host/Merkle.Adapters.Go.csproj" />
    <ProjectReference Include="../adapters/dotnet/worker/Merkle.Adapters.DotNet.Worker.csproj"
                      Condition="'$(MerkleIncludeDotNetAdapter)' == 'true'"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="../adapters/dotnet/observer/Merkle.Adapters.DotNet.Observer.csproj"
                      Condition="'$(MerkleIncludeDotNetAdapter)' == 'true'"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDotNetToolchain"
          AfterTargets="Publish"
          Condition="'$(MerkleIncludeDotNetAdapter)' == 'true'">
    <ItemGroup>
      <DotNetToolchainArtifact Include="$(MSBuildProjectDirectory)/../adapters/dotnet/worker/bin/$(Configuration)/net10.0/**/*"
                              Exclude="$(MSBuildProjectDirectory)/../adapters/dotnet/worker/bin/$(Configuration)/net10.0/$(RuntimeIdentifier)/**/*"
                              Condition="'$(RuntimeIdentifier)' != ''" />
      <DotNetToolchainArtifact Include="$(MSBuildProjectDirectory)/../adapters/dotnet/worker/bin/$(Configuration)/net10.0/**/*"
                              Condition="'$(RuntimeIdentifier)' == ''" />
      <DotNetToolchainArtifact Include="$(MSBuildProjectDirectory)/../adapters/dotnet/observer/bin/$(Configuration)/net8.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DotNetToolchainArtifact)"
          DestinationFiles="@(DotNetToolchainArtifact->'$(PublishDir)workers/dotnet/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)workers/dotnet/Merkle.Adapters.DotNet.Worker.dll')"
           Text="The published CLI is missing the managed .NET semantic worker." />
    <Error Condition="!Exists('$(PublishDir)workers/dotnet/Merkle.Adapters.DotNet.Observer.dll')"
           Text="The published CLI is missing the .NET startup-hook observer." />
  </Target>

  <Target Name="WriteDotNetAdapterManifest"
          AfterTargets="CopyDotNetToolchain"
          Condition="'$(MerkleIncludeDotNetAdapter)' == 'true'">
    <ItemGroup>
      <_DotNetWorkerManifest Include="$(PublishDir)workers/dotnet/Merkle.Adapters.DotNet.Worker.dll" />
      <_DotNetObserverManifest Include="$(PublishDir)workers/dotnet/Merkle.Adapters.DotNet.Observer.dll" />
    </ItemGroup>
    <GetFileHash Files="@(_DotNetWorkerManifest)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HashedDotNetWorkerManifest" />
    </GetFileHash>
    <GetFileHash Files="@(_DotNetObserverManifest)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HashedDotNetObserverManifest" />
    </GetFileHash>
    <PropertyGroup>
      <_MerkleManifestRuntime Condition="'$(RuntimeIdentifier)' == ''">portable</_MerkleManifestRuntime>
      <_MerkleManifestRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_MerkleManifestRuntime>
      <_DotNetWorkerHash>@(_HashedDotNetWorkerManifest->'%(FileHash)')</_DotNetWorkerHash>
      <_DotNetObserverHash>@(_HashedDotNetObserverManifest->'%(FileHash)')</_DotNetObserverHash>
      <_DotNetWorkerHash>$([System.String]::Copy('$(_DotNetWorkerHash)').ToLowerInvariant())</_DotNetWorkerHash>
      <_DotNetObserverHash>$([System.String]::Copy('$(_DotNetObserverHash)').ToLowerInvariant())</_DotNetObserverHash>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(PublishDir)adapters.json"
      Overwrite="true"
      Lines="{
  &quot;schemaVersion&quot;: 1,
  &quot;merkleVersion&quot;: &quot;$(Version)&quot;,
  &quot;configuration&quot;: &quot;$(Configuration)&quot;,
  &quot;runtimeIdentifier&quot;: &quot;$(_MerkleManifestRuntime)&quot;,
  &quot;adapters&quot;: [
    {
      &quot;id&quot;: &quot;dotnet&quot;,
      &quot;version&quot;: &quot;$(Version)&quot;,
      &quot;protocolVersion&quot;: &quot;1.0&quot;,
      &quot;profile&quot;: &quot;deep&quot;,
      &quot;artifacts&quot;: [
        { &quot;path&quot;: &quot;workers/dotnet/Merkle.Adapters.DotNet.Worker.dll&quot;, &quot;sha256&quot;: &quot;$(_DotNetWorkerHash)&quot; },
        { &quot;path&quot;: &quot;workers/dotnet/Merkle.Adapters.DotNet.Observer.dll&quot;, &quot;sha256&quot;: &quot;$(_DotNetObserverHash)&quot; }
      ]
    }
  ]
}" />
  </Target>

</Project>
